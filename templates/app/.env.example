# Copier en .env et remplir. Ne JAMAIS committer le .env rempli.
#
# L'hote de DATABASE_URL doit etre le nom du conteneur Postgres (<projet>-db),
# jamais l'alias "db" : voir docs/05-pannes.md.
DATABASE_URL=postgres://PROJET:CHANGE_ME@PROJET-db:5432/PROJET
POSTGRES_PASSWORD=CHANGE_ME

# Generer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=https://example.com

PORT=3000

# Inscription publique. FERMEE par defaut : sur un outil interne, l'ouvrir
# laisse n'importe qui se creer un compte. Creer les comptes avec :
#   ./scripts/create-user.sh email@exemple.fr "Nom"
# Le mot de passe est demande de facon interactive : le passer en argument le
# rendrait visible dans `ps` et le laisserait dans l'historique du shell.
ALLOW_PUBLIC_SIGNUP=false

# --- Anti-robots Cloudflare Turnstile (facultatif) --------------------------
# Laisser VIDE tant que vous n'avez pas cree vos cles : l'application marche
# sans, le widget ne s'affiche pas et aucun jeton n'est exige. Les deux cles
# vont ensemble — en definir une seule ne sert a rien.
#
# Ou les obtenir : dash.cloudflare.com > Turnstile > Add site.
# Voir docs/09-captcha.md.
#
# Cle PUBLIQUE, incluse dans le code envoye au navigateur (ce n'est pas un secret).
VITE_TURNSTILE_SITE_KEY=
# Cle SECRETE, jamais envoyee au navigateur.
TURNSTILE_SECRET_KEY=
