---
import '../styles/global.css'

interface Props {
  titre: string
  description: string
  /** true sur les pages qui ne doivent pas être indexées (remerciement, etc.) */
  noindex?: boolean
}

const { titre, description, noindex = false } = Astro.props

// URL canonique absolue. Sans elle, une même page atteignable par deux chemins
// est vue comme deux pages distinctes par les moteurs de recherche.
const canonique = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
  </head>

  <body class="min-h-screen bg-white text-slate-900 antialiased">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Aller au contenu
    </a>

    <header class="border-b border-slate-200">
      <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-5" aria-label="Navigation principale">
        <a href="/" class="font-semibold tracking-tight">Mon site</a>
        <ul class="flex gap-6 text-sm">
          <li><a href="/blog/" class="hover:underline">Blog</a></li>
          <li><a href="/a-propos/" class="hover:underline">À propos</a></li>
        </ul>
      </nav>
    </header>

    <main id="contenu" class="mx-auto max-w-3xl px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-slate-200">
      <div class="mx-auto max-w-3xl px-6 py-8 text-sm text-slate-500">
        <p>&copy; {new Date().getFullYear()} — Mon site</p>
      </div>
    </footer>
  </body>
</html>
