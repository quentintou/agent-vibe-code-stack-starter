# Copier vers /etc/caddy/sites/<projet>.caddy puis remplacer :
#   example.com -> votre domaine
#   APP_PORT    -> le port publie par le conteneur sur 127.0.0.1
#
# Ne jamais editer /etc/caddy/Caddyfile : il ne fait qu'importer ce dossier.
example.com {
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy 127.0.0.1:APP_PORT {
		# Transmet l'IP reelle du visiteur : sans elle, l'application ne peut
		# pas limiter le debit par client.
		header_up X-Real-IP {remote_host}
	}
}

www.example.com {
	redir https://example.com{uri} permanent
}
